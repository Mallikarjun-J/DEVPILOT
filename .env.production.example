# ==========================================
# DevPilot Production Environment Variables
# ==========================================

# 1. Database (Neon Serverless PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-lingering-bird-b5zb02a0-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=npg_KgXY1NIWjb0Q

# 2. Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PROJECT_ID=devpilot

# 3. GitHub OAuth App (Create at github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# 4. Domains & URLs
# FRONTEND_URL is where your Next.js app is hosted (e.g. https://devpilot.vercel.app)
FRONTEND_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# NEXT_PUBLIC_API_BASE_URL is where your Spring Boot backend is hosted (e.g. https://devpilot-backend.onrender.com)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-domain.com

# 5. Cross-domain Cookies (Set to 'none' and 'true' if backend & frontend are on different domains with HTTPS)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# 6. Security & Token Encryption
ENCRYPTION_PASSWORD=your-custom-encryption-secret-string
ENCRYPTION_SALT=5c0744940b5c369b
